stage1=caribeos-initrd-userspace
init=/sbin/init
services=/sbin/caribed
tools=/bin/caribectl
provides=/sbin/init,/sbin/caribed,/bin/caribectl,/bin/musl-probe,/bin/bash,/bin/interp-probe,/bin/dynamic-probe,/bin/dynamic-bias-probe,/lib/ld-caribe-rv32.so.1,/lib/libcaribe-probe.so.1,/lib/libcaribe-extra.so.1,/lib/libcaribe-chain.so.1,/lib/libcaribe-buckets.so.1,/etc/os-release,/etc/caribe-release,/etc/passwd,/etc/group,/caribe/stage1.manifest,/usr/lib/caribe.note,/usr/lib/bash-smoke.sh,/usr/bin/dynamic-script
procfs=/proc/version,/proc/cpuinfo,/proc/meminfo,/proc/uptime,/proc/stat,/proc/caribeos,/proc/bootlog,/proc/iokit,/proc/caribe/sbi,/proc/caribe/devices,/proc/caribe/memmap,/proc/self/maps,/proc/self/status,/proc/self/auxv,/proc/self/cmdline,/proc/self/environ
status=bootable-stage1-initrd-with-musl-and-gnu-bash-5.3.5
next=interactive GNU Bash console, real fork/clone tasking, brk/mmap-backed ld.so file loader
