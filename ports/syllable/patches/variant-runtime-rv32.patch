+bool Variant::_ValidateFlattened( const uint8* pBuffer, size_t nSize, unsigned nDepth )
+{
+	if( pBuffer == NULL || nSize < 4 || nSize > 8192 || nDepth > 16 ) return false;
+	uint32 nType;
+	memcpy( &nType, pBuffer, 4 );
+	size_t nPayload = nSize - 4;
+	switch( static_cast<type_code>( nType ) )
+	{
+	case T_ANY_TYPE: return nPayload == 0;
+	case T_POINTER:
+		if( nPayload != 4 ) return false;
+		memcpy( &nType, pBuffer + 4, 4 );
+		return nType == 0;
+	case T_INT8: case T_INT16:
+	{
+		if( nPayload != 4 ) return false;
+		int32 nValue;
+		memcpy( &nValue, pBuffer + 4, 4 );
+		return nType == T_INT8 ? ( nValue >= -128 && nValue <= 127 ) : ( nValue >= -32768 && nValue <= 32767 );
+	}
+	case T_INT32: case T_FLOAT: case T_COLOR32: return nPayload == 4;
+	case T_INT64: case T_DOUBLE: case T_POINT: case T_IPOINT: return nPayload == 8;
+	case T_BOOL: return nPayload == 1 && pBuffer[4] <= 1;
+	case T_RECT: case T_IRECT: return nPayload == 16;
+	case T_STRING: case T_RAW: case T_MESSAGE:
+	{
+		if( nPayload < 4 ) return false;
+		int32 nLength;
+		memcpy( &nLength, pBuffer + 4, 4 );
+		if( nLength < 0 || static_cast<size_t>( nLength ) != nPayload - 4 ) return false;
+		if( nType == T_STRING )
+			return nLength > 0 && pBuffer[nSize-1] == 0 && memchr( pBuffer + 8, 0, nLength-1 ) == NULL;
+		if( nType == T_MESSAGE ) return Message::_ValidateFlattened( pBuffer + 8, nLength, nDepth + 1 );
+		return true;
+	}
+	default: return false;
+	}
+}
