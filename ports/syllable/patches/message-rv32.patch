+
+bool Message::_ValidateFlattened( const uint8 *pBuffer, size_t nSize, unsigned nDepth )
+{
+	if( pBuffer == NULL || nSize < 28 || nSize > CARIBE_MESSAGE_LIMIT || nDepth > 16 ) return false;
+	uint32 nDeclared;
+	memcpy( &nDeclared, pBuffer, sizeof( nDeclared ) );
+	if( nDeclared != nSize ) return false;
+	size_t nPos = 28;
+	while( nPos < nSize )
+	{
+		if( nSize - nPos < sizeof( DataArray_s ) ) return false;
+		DataArray_s cArray;
+		memcpy( &cArray, pBuffer + nPos, sizeof( cArray ) );
+		if( cArray.nCurSize < static_cast<int>( sizeof( DataArray_s ) ) ||
+		    static_cast<size_t>( cArray.nCurSize ) > nSize - nPos || cArray.nCount <= 0 ||
+		    cArray.nCount > 8192 || cArray.nChunkSize < 0 ||
+		    cArray.nNameLength > cArray.nCurSize - sizeof( DataArray_s ) ) return false;
+		size_t nEnd = nPos + cArray.nCurSize;
+		size_t nData = nPos + sizeof( DataArray_s ) + cArray.nNameLength;
+		if( memchr( pBuffer + nPos + sizeof( DataArray_s ), 0, cArray.nNameLength ) != NULL ) return false;
+		size_t nScalar = 0;
+		switch( cArray.nTypeCode )
+		{
+		case T_INT8: case T_BOOL: nScalar = 1; break;
+		case T_INT16: nScalar = 2; break;
+		case T_POINTER: case T_INT32: case T_FLOAT: case T_COLOR32: nScalar = 4; break;
+		case T_INT64: case T_DOUBLE: case T_POINT: case T_IPOINT: nScalar = 8; break;
+		case T_RECT: case T_IRECT: nScalar = 16; break;
+		default: break;
+		}
+		if( nScalar != 0 && cArray.nChunkSize != static_cast<int>( nScalar ) ) return false;
+		if( cArray.nChunkSize != 0 && static_cast<uint64>( cArray.nChunkSize ) * cArray.nCount != nEnd - nData ) return false;
+		for( int nIndex = 0; nIndex < cArray.nCount; ++nIndex )
+		{
+			size_t nChunk = cArray.nChunkSize;
+			if( nChunk == 0 )
+			{
+				if( nEnd - nData < sizeof( int32 ) ) return false;
+				int32 nLength;
+				memcpy( &nLength, pBuffer + nData, sizeof( nLength ) );
+				if( nLength < 0 ) return false;
+				nData += sizeof( nLength );
+				nChunk = nLength;
+			}
+			if( nChunk > nEnd - nData ) return false;
+			if( cArray.nTypeCode == T_STRING && ( nChunk == 0 || pBuffer[nData + nChunk - 1] != 0 ) ) return false;
+			if( cArray.nTypeCode == T_BOOL && pBuffer[nData] > 1 ) return false;
+			if( cArray.nTypeCode == T_MESSAGE && !_ValidateFlattened( pBuffer + nData, nChunk, nDepth + 1 ) ) return false;
+			nData += nChunk;
+		}
+		if( nData != nEnd ) return false;
+		nPos = nEnd;
+	}
+	return nPos == nSize;
+}
+
+status_t Message::Unflatten( const uint8 *pBuffer, size_t nSize )
+{
+	static_assert( sizeof( DataArray_s ) == 28, "RV32 Message wire layout changed" );
+	if( !_ValidateFlattened( pBuffer, nSize, 0 ) ) { errno = EINVAL; return -1; }
+	int32 nHeader[7];
+	memcpy( nHeader, pBuffer, sizeof( nHeader ) );
+	Message cDecoded( nHeader[1] );
+	cDecoded.m_nTargetToken = nHeader[2];
+	cDecoded.m_nReplyToken = nHeader[3];
+	cDecoded.m_hReplyPort = nHeader[4];
+	cDecoded.m_hReplyProc = nHeader[5];
+	cDecoded.m_nFlags = nHeader[6] & ~REPLY_SENT;
+	cDecoded.m_nFlattenedSize = nSize;
+	for( size_t nPos = sizeof( nHeader ); nPos < nSize; )
+	{
+		DataArray_s cArray;
+		memcpy( &cArray, pBuffer + nPos, sizeof( cArray ) );
+		DataArray_s *psNew = static_cast<DataArray_s *>( malloc( cArray.nCurSize ) );
+		if( psNew == NULL ) { errno = ENOMEM; return -1; }
+		memcpy( psNew, pBuffer + nPos, cArray.nCurSize );
+		psNew->psNext = NULL;
+		psNew->nMaxSize = cArray.nCurSize;
+		cDecoded._AddArray( psNew );
+		nPos += cArray.nCurSize;
+	}
+	std::swap( m_nCode, cDecoded.m_nCode );
+	std::swap( m_nTargetToken, cDecoded.m_nTargetToken );
+	std::swap( m_nReplyToken, cDecoded.m_nReplyToken );
+	std::swap( m_hReplyPort, cDecoded.m_hReplyPort );
+	std::swap( m_hReplyProc, cDecoded.m_hReplyProc );
+	std::swap( m_nFlags, cDecoded.m_nFlags );
+	std::swap( m_nFlattenedSize, cDecoded.m_nFlattenedSize );
+	std::swap( m_psFirstArray, cDecoded.m_psFirstArray );
+	m_pcNext = NULL;
 	return ( 0 );
 }
 
