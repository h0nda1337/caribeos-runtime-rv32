* text=auto
*.c text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.S text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.sh text eol=lf
*.py text eol=lf
# Unified-diff context intentionally prefixes original tabs/blank lines with a space.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
*.md text eol=lf
*.txt text eol=lf
Makefile text eol=lf
*.ps1 text eol=crlf
